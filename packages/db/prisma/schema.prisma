generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Quién opera el sistema. Son tres, y el estudiante no está entre ellos:
// el estudiante es el SUJETO del trámite, no un actor de la aplicación.
// Sus datos los carga la coordinación y sus documentos se los entrega la
// Facultad por sus canales; nunca inicia sesión ni consulta nada aquí, así
// que no tiene cuenta ni credenciales que proteger.
enum Role {
  ADMIN
  COORDINATOR
  SIGNER
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  role      Role
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  suspendedAt DateTime?  // cuenta inhabilitada: no puede iniciar sesión (reversible)

  coordinator        Coordinator?
  signerProfile      SignerProfile?
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  excelImports       ExcelImport[]
  generatedDocuments GeneratedDocument[]
  invalidatedDocuments GeneratedDocument[] @relation("DocumentInvalidation")
  deanSignedItems    SignatureBatchItem[] @relation("ItemDeanSigner")
  directorSignedItems SignatureBatchItem[] @relation("ItemDirectorSigner")
  finalSignedItems   SignatureBatchItem[] @relation("ItemFinalSigner")
  signatureBatches   SignatureBatch[]
  generationBatches  GenerationBatch[]
  userInvitations    UserInvitation[] @relation("UserInvitations")
  registeredApprovals Practice[]      @relation("PracticeApprovalRegistrar")
  completionRecords  CompletionRecord[]
  returnedDocuments  GeneratedDocument[] @relation("DocumentReturned")
  deanAcademicPeriods AcademicPeriod[] @relation("AcademicPeriodDean")
  directorAcademicPeriods AcademicPeriod[] @relation("AcademicPeriodDirector")

  @@map("users")
}

model Faculty {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  abbreviation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  coordinators  Coordinator[]
  programs      Program[]
  students      Student[]
  practices     Practice[]
  excelImports  ExcelImport[]
  documentTemplates DocumentTemplate[]
  userInvitations UserInvitation[]
  signerProfiles  SignerProfile[]
  practiceLabels  PracticeLabel[]
  tutors          Tutor[]
  completionRecords CompletionRecord[]

  @@map("faculties")
}

model Coordinator {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  facultyId String   @db.Uuid
  programId String?  @db.Uuid  // carrera específica que coordina (la facultad se deriva de ella)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user      User     @relation(fields: [userId], references: [id])
  faculty   Faculty  @relation(fields: [facultyId], references: [id])
  program   Program? @relation(fields: [programId], references: [id])

  @@map("coordinators")
}

model Program {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  abbreviation String?
  facultyId   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  students    Student[]
  coordinators Coordinator[]
  tutors      Tutor[]

  @@map("programs")
}

// El estudiante es un registro de información, no una cuenta: nombre, cédula
// y a qué carrera pertenece son los datos que los documentos imprimen. No
// lleva userId porque no hay usuario que enlazar.
model Student {
  id          String   @id @default(uuid()) @db.Uuid
  facultyId   String   @db.Uuid
  programId   String   @db.Uuid
  dni         String   @unique
  firstName   String
  lastName    String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  program     Program  @relation(fields: [programId], references: [id])
  practices   Practice[]
  generatedDocs GeneratedDocument[]

  @@map("students")
}

model Company {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  address       String?
  contactName   String?
  email         String?
  phone         String?
  recipientName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  practices     Practice[]

  @@map("companies")
}

enum PracticeStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  DELAYED
  CANCELED
}

model Practice {
  id              String   @id @default(uuid()) @db.Uuid
  studentId       String   @db.Uuid
  companyId       String   @db.Uuid
  facultyId       String   @db.Uuid
  academicPeriod  String   @default("2024-1")
  // Docente tutor. `tutorId` es el dato de verdad desde el RF-23; `tutorName`
  // sobrevive como copia del nombre para que las plantillas de documento y los
  // reportes sigan leyendo un texto. La escribe un solo sitio -el ayudante de
  // asignacion de tutor- para que no vuelva a haber dos versiones de la verdad.
  tutorId         String?  @db.Uuid
  tutorName       String?
  practiceLevel   String?
  academicLevel   String?
  // Área de la empresa donde el estudiante desempeñará las actividades.
  // La solicitud oficial (PAP-001) la imprime: "en el área de: ___".
  workArea        String?
  status          PracticeStatus @default(PENDING)
  // Etiqueta que pone el coordinador a mano. Es una anotación de seguimiento
  // («la empresa no aprueba aún», «no contestan») y NO interviene en `status`,
  // que el sistema sigue derivando de los documentos emitidos.
  labelId         String?  @db.Uuid
  startDate       DateTime?
  endDate         DateTime?
  totalHours      Int      @default(0)

  // -- RF-18: aprobacion del tutor por acta de culminacion --
  // Sin esta marca no se emite el certificado. Queda a nombre del tutor que
  // firma el acta -que puede no ser el asignado- y de quien la registro.
  tutorApprovedAt        DateTime?
  approvalTutorId        String?  @db.Uuid
  approvalRegisteredById String?  @db.Uuid
  completionRecordId     String?  @db.Uuid

  // -- RF-19 y RF-21: cierre con motivo, y cadena con la que la sucede --
  // Reasignar y dar de baja son el mismo gesto en la base: se cierra la
  // practica con su motivo. Lo que las distingue es si nace otra despues.
  closedAt           DateTime?
  closureReasonId    String?  @db.Uuid
  closureNote        String?
  previousPracticeId String?  @db.Uuid

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  student         Student  @relation(fields: [studentId], references: [id])
  company         Company  @relation(fields: [companyId], references: [id])
  faculty         Faculty  @relation(fields: [facultyId], references: [id])
  period          AcademicPeriod? @relation(fields: [academicPeriod], references: [code])
  label           PracticeLabel? @relation(fields: [labelId], references: [id], onDelete: SetNull)
  tutor           Tutor?   @relation("PracticeTutor", fields: [tutorId], references: [id])
  approvalTutor   Tutor?   @relation("PracticeTutorApproval", fields: [approvalTutorId], references: [id])
  approvalRegisteredBy User? @relation("PracticeApprovalRegistrar", fields: [approvalRegisteredById], references: [id])
  completionRecord CompletionRecord? @relation(fields: [completionRecordId], references: [id], onDelete: SetNull)
  closureReason   ReasonCode? @relation(fields: [closureReasonId], references: [id])
  previousPractice Practice?  @relation("PracticeChain", fields: [previousPracticeId], references: [id])
  nextPractices   Practice[] @relation("PracticeChain")

  // El tope de veinte se comprueba al asignar, al importar y al reasignar:
  // conviene que contar salga barato.
  @@index([tutorId, academicPeriod])
  @@index([companyId, academicPeriod])
  @@map("practices")
}

// Etiqueta de seguimiento que el coordinador asigna a una práctica.
//
// Son anotaciones propias del equipo, no estados del proceso: recogen lo que
// el sistema no puede deducir de los documentos («la empresa no responde»).
// Por eso conviven con `Practice.status` sin sustituirlo.
//
// `requiresCompletion` marca la única etiqueta con condición: solo puede
// asignarse cuando la práctica tiene sus tres documentos vigentes y el
// certificado ya firmado. El servidor lo verifica; la interfaz solo lo anticipa.
model PracticeLabel {
  id                 String   @id @default(uuid()) @db.Uuid
  facultyId          String   @db.Uuid
  name               String
  /// Color en hexadecimal, p. ej. "#16a34a"
  color              String
  /// Etiqueta base creada por el sistema: no se puede eliminar
  isSystem           Boolean  @default(false)
  /// Exige tres documentos vigentes y certificado firmado para poder asignarse
  requiresCompletion Boolean  @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  faculty            Faculty    @relation(fields: [facultyId], references: [id])
  practices          Practice[]

  @@unique([facultyId, name])
  @@map("practice_labels")
}

model DocumentTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  type        String   
  content     Json     
  facultyId   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  generatedDocs GeneratedDocument[]

  @@map("document_templates")
}

enum DocumentStatus {
  VALID
  INVALIDATED
  SUPERSEDED
}

model GeneratedDocument {
  id            String   @id @default(uuid()) @db.Uuid
  templateId    String   @db.Uuid
  studentId     String   @db.Uuid
  generatedById String?  @db.Uuid
  fileUrl       String   // objectKey en MinIO (no URL absoluta)
  documentCode  String?
  documentType  String?
  status        DocumentStatus @default(VALID)
  invalidatedAt DateTime?
  // `invalidReasonId` es el motivo tipificado (RF-24) e `invalidReason` pasa a
  // ser la nota libre que lo acompaña, no el motivo entero.
  invalidReasonId String? @db.Uuid
  invalidReason String?
  invalidatedById String? @db.Uuid  // quién lo invalidó (trazabilidad)
  /// Cuándo se retiró el archivo de MinIO.
  ///
  /// Una versión equivocada no se conserva: en cuanto se anula, el archivo se
  /// borra del almacén. Lo que queda es ESTA fila —código, tipo, estudiante,
  /// motivo, quién y cuándo—, que es el historial. Antes el archivo vivía
  /// treinta días y después se borraba la fila entera, justo al revés: se
  /// guardaba el documento errado y se perdía el rastro de que existió.
  fileRemovedAt DateTime?
  version       Int      @default(1)
  replacedById  String?  @db.Uuid
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  // ── Flujo de firma digital ──
  signatureStatus SignatureStatus @default(NONE)
  signedFileKey   String?         // objectKey del PDF con ambas firmas
  signedChecksum  String?         // SHA-256 del archivo firmado final
  signedAt        DateTime?

  // ── Copia devuelta por la empresa (RF-27) ──
  // El oficio sale del sistema, la empresa lo firma y lo sella en papel, y esa
  // copia escaneada vuelve. NO se guarda en `signedFileKey`: ese campo es del
  // circuito de firma electrónica y su checksum acompaña a un PDF concreto;
  // pisarlo con un escaneo dejaría la huella apuntando a otro archivo.
  returnedFileKey String?
  returnedFileName String?
  returnedAt      DateTime?
  returnedById    String?  @db.Uuid

  template      DocumentTemplate @relation(fields: [templateId], references: [id])
  student       Student          @relation(fields: [studentId], references: [id])
  generatedBy   User?            @relation(fields: [generatedById], references: [id])
  invalidatedBy User?            @relation("DocumentInvalidation", fields: [invalidatedById], references: [id])
  replacedBy    GeneratedDocument? @relation("DocumentReplacement", fields: [replacedById], references: [id])
  replaces      GeneratedDocument[] @relation("DocumentReplacement")
  signatureItems SignatureBatchItem[]
  invalidReasonCode ReasonCode? @relation(fields: [invalidReasonId], references: [id])
  returnedBy    User?            @relation("DocumentReturned", fields: [returnedById], references: [id])

  @@map("generated_documents")
}

// ═══════════════ TUTORÍA ACADÉMICA ═══════════════

// Docente que la carrera asigna para acompañar las prácticas.
//
// Hasta el RF-23 vivía como texto libre dentro de la práctica, y eso impedía
// dos cosas que el tribunal pidió: contar cuántos estudiantes lleva cada uno
// -«Ing. Pérez» e «Ing. Perez» contaban por separado- y agrupar el oficio de
// designación por empresa y tutor, que es la unidad real del papel cuando dos
// docentes tienen estudiantes en la misma empresa.
model Tutor {
  id          String   @id @default(uuid()) @db.Uuid
  facultyId   String   @db.Uuid
  programId   String?  @db.Uuid
  fullName    String
  dni         String?
  email       String?
  phone       String?
  title       String?  // "Ing." / "Mg.", tal como el oficio lo imprime
  /// Tope de estudiantes simultáneos por período (RF-22). Vive por docente y no
  /// como constante para poder excepcionar un caso sin tocar el código.
  maxStudents Int      @default(20)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  program     Program? @relation(fields: [programId], references: [id])
  practices   Practice[] @relation("PracticeTutor")
  approvals   Practice[] @relation("PracticeTutorApproval")
  completionRecords CompletionRecord[]

  @@unique([facultyId, fullName])
  @@map("tutors")
}

// Acta de culminación que el tutor entrega y el coordinador carga.
//
// El sistema rastrea las cédulas por patrón -diez dígitos- y no por la
// estructura de la tabla, así que sigue funcionando aunque Xisce cambie el
// formato del acta. Lo que no corresponde a un estudiante con práctica activa
// en el período se descarta solo.
//
// El archivo se conserva 30 días y después lo barre la purga programada: el
// acta ya vive en Xisce y guardarla dos veces es duplicar sin motivo.
model CompletionRecord {
  id             String   @id @default(uuid()) @db.Uuid
  facultyId      String   @db.Uuid
  academicPeriod String
  /// Docente a cuyo nombre queda la aprobación. NO se elige a mano: se
  /// reconoce leyendo la cabecera del propio acta (`professorRaw`). Antes había
  /// un desplegable que permitía atribuir el acta a un docente distinto del que
  /// la firma, que es justo lo que un acta no debe permitir.
  tutorId        String   @db.Uuid
  fileKey        String?  // objectKey en MinIO; nulo una vez purgado a los 30 días
  fileName       String?

  // Lo que el acta declara de sí misma. Se guarda tal como viene para poder
  // responder «¿qué acta aprobó a este estudiante?» sin conservar el archivo,
  // que se purga a los 30 días. El número y la versión bastan para pedirla otra
  // vez al sistema académico.
  actaNumber     String?
  actaVersion    String?
  subject        String?  // «PRÁCTICAS LABORALES II»
  courseCode     String?  // «IS-806»
  level          String?  // «8»
  parallel       String?  // «F»
  /// Nombre del docente tal como lo imprime el acta, que viene en orden
  /// APELLIDOS NOMBRES y no siempre coincide con la grafía del sistema.
  professorRaw   String?
  /// Cuántas cédulas traía el acta y a cuántas se les halló práctica activa
  totalDnis      Int      @default(0)
  matchedCount   Int      @default(0)
  uploadedById   String   @db.Uuid
  purgeAt        DateTime
  createdAt      DateTime @default(now())

  faculty        Faculty  @relation(fields: [facultyId], references: [id])
  tutor          Tutor    @relation(fields: [tutorId], references: [id])
  uploadedBy     User     @relation(fields: [uploadedById], references: [id])
  approvedPractices Practice[]

  @@index([purgeAt])
  @@map("completion_records")
}

// ═══════════════ MOTIVOS TIPIFICADOS (RF-24) ═══════════════

enum ReasonScope {
  DOCUMENT  // invalidar un documento ya emitido
  PRACTICE  // cerrar o dar de baja una práctica
  BOTH
}

// Catálogo administrable de motivos. El `code` es lo que los reportes agrupan,
// así que se mantiene estable aunque se reescriba la etiqueta que se ve.
model ReasonCode {
  id        String      @id @default(uuid()) @db.Uuid
  code      String      @unique
  label     String
  scope     ReasonScope @default(BOTH)
  /// Motivo base creado por el sistema: se puede desactivar, no eliminar
  isSystem  Boolean     @default(false)
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  closedPractices      Practice[]
  invalidatedDocuments GeneratedDocument[]

  @@map("reason_codes")
}

// ═══════════════ FIRMA DIGITAL (FirmaEC) ═══════════════

enum SignatureStatus {
  NONE            // no requiere firma / no enviado
  IN_SIGNING      // dentro de un lote de firma en curso
  PARTIALLY_SIGNED// firmado por la primera autoridad
  SIGNED          // firmado por ambas autoridades y publicado
  REJECTED        // rechazado por un firmante
}

enum SignerRole {
  DEAN      // Decano: firma en segundo lugar, sobre el PDF que ya suscribió el responsable
  DIRECTOR  // Responsable de Prácticas: firma primero
}

// Invitación genérica para que cualquier rol se auto-registre (ADMIN, COORDINATOR, SIGNER)
// mediante un link con token de un solo uso.
model UserInvitation {
  id          String     @id @default(uuid()) @db.Uuid
  token       String     @unique
  role        Role       @default(SIGNER)
  signerRole  SignerRole?
  facultyId   String?    @db.Uuid
  programId   String?    @db.Uuid  // carrera que coordinará (deriva la facultad)
  email       String?    // si el admin la fija, el registro exige este correo
  fullName    String?    // pre-llenado opcional
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String     @db.Uuid
  createdAt   DateTime   @default(now())

  createdBy   User       @relation("UserInvitations", fields: [createdById], references: [id])
  faculty     Faculty?   @relation(fields: [facultyId], references: [id])

  @@map("user_invitations")
}

// Vincula a un usuario con rol SIGNER con la autoridad que representa
model SignerProfile {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @unique @db.Uuid
  signerRole SignerRole
  fullName   String
  title      String?    // ej. "Decano de la Facultad de Ciencias de la Vida"
  dni        String?
  phone      String?
  facultyId  String?    @db.Uuid
  createdAt  DateTime   @default(now())

  user       User     @relation(fields: [userId], references: [id])
  faculty    Faculty? @relation(fields: [facultyId], references: [id])

  @@map("signer_profiles")
}

enum SignatureBatchStatus {
  PENDING_DIRECTOR // 1. esperando firma del responsable de prácticas (primero)
  PENDING_DEAN     // 2. esperando firma del decano (segundo)
  COMPLETED        // ambas firmas subidas y publicadas
  CANCELLED
}

model SignatureBatch {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique // ej. LOTE-2026-1-00001
  name        String?
  status      SignatureBatchStatus @default(PENDING_DIRECTOR)
  createdById String               @db.Uuid
  deanSignedAt     DateTime?
  directorSignedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy   User                 @relation(fields: [createdById], references: [id])
  items       SignatureBatchItem[]

  @@map("signature_batches")
}

enum SignatureItemStatus {
  PENDING             // sin firmas
  SIGNED_BY_DIRECTOR  // primera firma subida (por el responsable)
  SIGNED_BY_DEAN      // firma del decano
  SIGNED              // ambas firmas subidas y verificadas
  REJECTED
}

model SignatureBatchItem {
  id             String              @id @default(uuid()) @db.Uuid
  batchId        String              @db.Uuid
  documentId     String              @db.Uuid
  status         SignatureItemStatus @default(PENDING)
  directorFileKey String?            // objectKey del PDF firmado por el responsable
  directorChecksum String?
  directorSignedById String?         @db.Uuid  // qué usuario firmó como Responsable
  deanFileKey    String?             // objectKey del PDF firmado por el decano
  deanChecksum   String?
  deanSignedById String?             @db.Uuid  // qué usuario firmó como Decano
  finalFileKey   String?             // objectKey del PDF con ambas firmas
  finalChecksum  String?
  finalSignedById String?            @db.Uuid  // qué usuario completó la firma final
  rejectReason   String?
  updatedAt      DateTime            @updatedAt
  createdAt      DateTime            @default(now())

  batch          SignatureBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  document       GeneratedDocument @relation(fields: [documentId], references: [id])
  directorSignedBy User?           @relation("ItemDirectorSigner", fields: [directorSignedById], references: [id])
  deanSignedBy   User?             @relation("ItemDeanSigner", fields: [deanSignedById], references: [id])
  finalSignedBy  User?             @relation("ItemFinalSigner", fields: [finalSignedById], references: [id])

  @@unique([batchId, documentId])
  @@map("signature_batch_items")
}

// ═══════════════ GENERACIÓN MASIVA (BullMQ) ═══════════════

enum GenerationBatchStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
}

model GenerationBatch {
  id          String                @id @default(uuid()) @db.Uuid
  templateId  String                @db.Uuid
  total       Int
  completed   Int                   @default(0)
  failed      Int                   @default(0)
  status      GenerationBatchStatus @default(PROCESSING)
  createdById String?               @db.Uuid
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  createdBy   User? @relation(fields: [createdById], references: [id])

  @@map("generation_batches")
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExcelImport {
  id          String   @id @default(uuid()) @db.Uuid
  fileName    String
  fileUrl     String
  status      ImportStatus @default(PENDING)
  facultyId   String   @db.Uuid
  uploadedBy  String   @db.Uuid
  errorLogs   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  user        User     @relation(fields: [uploadedBy], references: [id])

  @@map("excel_imports")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user      User     @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  tableName  String
  recordId   String   @db.Uuid
  oldData    Json?
  newData    Json?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model AcademicPeriod {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(false)
  
  deanName      String?
  directorName  String?

  // Datos de contacto del Responsable de Prácticas que los oficios oficiales
  // imprimen bajo su firma. Cambian cuando cambia la persona del cargo, por eso
  // viven junto al periodo y no dentro de la plantilla.
  directorDni   String?
  directorPhone String?
  directorEmail String?

  deanUserId    String?  @db.Uuid
  directorUserId String?  @db.Uuid

  deanUser      User?    @relation("AcademicPeriodDean", fields: [deanUserId], references: [id])
  directorUser  User?    @relation("AcademicPeriodDirector", fields: [directorUserId], references: [id])

  practices     Practice[]
  sequences     DocumentSequence[]

  @@map("academic_periods")
}

model DocumentSequence {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   
  periodCode  String   
  lastNumber  Int      @default(0)
  
  period      AcademicPeriod @relation(fields: [periodCode], references: [code])

  @@unique([type, periodCode])
  @@map("document_sequences")
}
